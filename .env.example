# ============= LLM 配置 =============
# 可选 Provider: volcengine | bailian | token_plan | anthropic
DEFAULT_LLM_PROVIDER=token_plan
DEFAULT_MODEL_NAME=qwen3.6-plus
TITLE_LLM_TIMEOUT_SECONDS=60
LOCATOR_LLM_TIMEOUT_SECONDS=90
LOCATOR_MAX_TOKENS=1200
LOCATOR_NETWORK_MAX_RETRIES=1
REQUIREMENTS_DIMENSION_CONCURRENCY=3
REQUIREMENTS_LLM_CONCURRENCY=3
REQUIREMENTS_CALL_TIMEOUT_SECONDS=300
REQUIREMENTS_FILE_COMPOSITION_TIMEOUT_SECONDS=600
REQUIREMENTS_SPLIT_CALL_TIMEOUT_SECONDS=90
LLM_NETWORK_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=1
LLM_RETRY_MAX_SECONDS=12

# 火山引擎(coding plan)
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
VOLCENGINE_MODEL_NAME=glm-5.1

# Anthropic Claude(可选)
ANTHROPIC_API_KEY=

# OpenAI(可选)
OPENAI_API_KEY=

# 阿里云百炼 / DashScope OpenAI 兼容接口
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
BAILIAN_MODEL_NAME=qwen3.6-plus

# 阿里云 Token Plan / MaaS OpenAI 兼容接口
TOKEN_PLAN_API_KEY=
TOKEN_PLAN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
TOKEN_PLAN_MODEL_NAME=qwen3.6-plus

# Cost estimation (USD / 1M tokens)
COST_VOLCENGINE_INPUT_PER_M=0.8
COST_VOLCENGINE_OUTPUT_PER_M=2.0
COST_BAILIAN_INPUT_PER_M=0.8
COST_BAILIAN_OUTPUT_PER_M=2.0
COST_ANTHROPIC_INPUT_PER_M=3.0
COST_ANTHROPIC_OUTPUT_PER_M=15.0

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_CONNECT_TIMEOUT_SECONDS=5
DB_POOL_TIMEOUT_SECONDS=5

# Optional external SSO and per-user project isolation.
# Keep disabled for standalone local development.
EXTERNAL_AUTH_ENABLED=false
EXTERNAL_AUTH_COOKIE_NAME=External-Auth-Token
EXTERNAL_AUTH_GETINFO_URL=https://sso.example.com/api/getInfo
EXTERNAL_AUTH_TIMEOUT_SECONDS=8
EXTERNAL_AUTH_CACHE_TTL_SECONDS=120
EXTERNAL_AUTH_DEV_USER_ID=local-dev
EXTERNAL_AUTH_DEV_NICK_NAME=Local Developer

# ============= LangSmith tracing (disabled by default) =============
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
LANGSMITH_TRACING_V2=false
