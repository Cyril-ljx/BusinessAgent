# Knowledge-base binaries and customer material. Keep only schema/code.
data/knowledge/certs/
data/knowledge/master/
data/knowledge/history/
data/knowledge/companies/
data/knowledge/shared/
data/knowledge/imports/

# Office lock files and local documents
~$*
*.docx~
*.doc~

# Local database/cache files
*.db
*.sqlite
*.sqlite3
*.duckdb
*.db-shm
*.db-wal

# Temporary diagnostics
.tmp/
data/tmp/
data/tmp_*/
data/phase2_*.json
outputs/
